# ============================================
# Dependencies
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ============================================
# Secrets & Environment Files (CRITICAL)
# ============================================
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.pfx
*.p12
*.cer
credentials.json
service-account*.json
*-credentials.json
secrets.json
*.secret
*.secrets

# ============================================
# Logs e dados locais de IAs (Cursor, Claude, Copilot)
# ============================================
# NOTA: regras ativas de ignore — cada linha previne tracking de dados sensíveis/locais de IA
# .cursor/ e .claude/ NÃO são ignorados por completo, para permitir versionar
# .cursor/rules/ e .claude/settings.json (config compartilhada da equipe)

# Cursor - ignora apenas dados locais, mantém rules/ versionável
.cursor/chats/
.cursor/projects/
.cursor/local.json
.cursor/*.log

# Claude - ignora apenas dados locais, mantém settings.json versionável
.claude/local.json
.claude/*.log
.claude/projects/

# Windsurf
.windsurf/config.local.json
.windsurf/logs/

# VS Code - versiona settings.json (config compartilhada), ignora dados locais
.vscode/settings.local.json
.vscode/*.log
.vscode/launch.json
.vscode/debug.log

# JetBrains - versiona configs compartilhadas, ignora dados locais
.idea/workspace.xml
.idea/usage.statistics.xml
.idea/shelf/
.idea/tasks.xml
.idea/*.log

# ============================================
# Build outputs
# ============================================
dist/
build/
.next/
out/
.cache/
*.tsbuildinfo

# ============================================
# IDE and editor files
# ============================================
# NOTA: .vscode/ e .idea/ têm regras granulares acima (linhas 53-64)
# Não ignorar diretórios inteiros para permitir versionar configs compartilhadas
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# ============================================
# Testing & Coverage
# ============================================
coverage/
.nyc_output/

# ============================================
# Temporary files
# ============================================
*.tmp
*.temp
*.log

# ============================================
# Husky internal
# ============================================
.husky/_

# ============================================
# Misc
# ============================================
.eslintcache
.stylelintcache
