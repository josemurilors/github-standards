{
  "name": "{{PROJECT_NAME}}",
  "version": "1.0.0",
  "private": true,
  "description": "{{PROJECT_DESCRIPTION}}",
  "scripts": {
    "lint:md": "markdownlint-cli2 '**/*.md' '!node_modules/**/*.md'",
    "lint:md:fix": "markdownlint-cli2 '**/*.md' '!node_modules/**/*.md' --fix",
    "lint:links": "lychee '*.md' '**/*.md'",
    "lint:links:verbose": "lychee --verbose '*.md' '**/*.md'",
    "lint:secrets": "gitleaks detect --source . -v --config .gitleaks.toml",
    "lint:secrets:staged": "gitleaks detect --source . --staged -v --config .gitleaks.toml",
    "verify:gitignore": "./scripts/verify-gitignore.sh",
    "prepare": "husky",
    "test": "npm run lint:md && npm run lint:links && npm run lint:secrets",
    "mode:en": "./scripts/set-mode.sh en-first",
    "mode:pt": "./scripts/set-mode.sh pt-br-first"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "husky": "^9.0.0",
    "markdownlint-cli2": "^0.13.0",
    "semantic-release": "^23.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
