{
  "name": "github-standards-cli",
  "version": "2.4.0",
  "description": "CLI to standardize GitHub repositories with bilingual documentation, CI/CD pipelines, and 4-layer secret security for Vibe Coding",
  "main": "bin/cli.js",
  "bin": {
    "github-standards": "./bin/cli.js"
  },
  "files": [
    "bin/",
    "src/",
    "templates/"
  ],
  "scripts": {
    "lint:md": "markdownlint-cli2 '**/*.md' '!node_modules/**/*.md' '!templates/**/*.md'",
    "lint:md:fix": "markdownlint-cli2 '**/*.md' '!node_modules/**/*.md' '!templates/**/*.md' --fix",
    "lint:links": "lychee '*.md' '**/*.md'",
    "lint:links:verbose": "lychee --verbose '*.md' '**/*.md'",
    "lint:secrets": "gitleaks detect --source . -v --config .gitleaks.toml",
    "lint:secrets:staged": "gitleaks detect --source . --staged -v --config .gitleaks.toml",
    "verify:gitignore": "./scripts/verify-gitignore.sh",
    "prepare": "husky",
    "test": "npm run lint:md && npm run lint:links && npm run lint:secrets",
    "mode:en": "./scripts/set-mode.sh en-first",
    "mode:pt": "./scripts/set-mode.sh pt-br-first"
  },
  "keywords": [
    "github",
    "git",
    "ci-cd",
    "security",
    "documentation",
    "bilingual",
    "conventional-commits",
    "gitleaks",
    "vibe-coding",
    "cli",
    "scaffold"
  ],
  "author": "Jose Murilo <josemurilors@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/josemurilors/github-standards.git"
  },
  "bugs": {
    "url": "https://github.com/josemurilors/github-standards/issues"
  },
  "homepage": "https://github.com/josemurilors/github-standards#readme",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^8.2.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.5",
    "husky": "^9.0.0",
    "markdownlint-cli2": "^0.13.0",
    "semantic-release": "^23.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
